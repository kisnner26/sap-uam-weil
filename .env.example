# Copiar a .env y completar. Nunca subir .env al repositorio.
DB_PASSWORD=
APP_PUBLIC_URL=https://admision.ejemplo.edu.ni
APP_JWT_SECRET=            # >= 32 caracteres aleatorios: openssl rand -base64 48
APP_MFA_ENCRYPTION_KEY=    # exactamente 32 bytes: openssl rand -base64 24
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=   # temporal; cambiarla tras el primer ingreso
APP_MAIL_FROM=admision@ejemplo.edu.ni
APP_PRIVACY_EMAIL=privacidad@ejemplo.edu.ni
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
